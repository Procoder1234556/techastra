# Copy to .env and fill in values

DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

PORT=3001
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
DEMO_ACCESS_CODE=

# Local dev: point client at API. On Vercel leave VITE_API_URL unset (same-origin).
VITE_API_URL=http://localhost:3001
VITE_DEMO_ACCESS_CODE=

# Production: set CLIENT_URL to https://your-app.vercel.app on Vercel
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# MailerHub — SMTP (e.g. Gmail app password, SendGrid, Mailtrap)
EMAIL_PROVIDER=auto
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Techastra
EMAIL_REPLY_TO=

# Or ZeptoMail (https://www.zoho.com/zeptomail/)
ZEPTOMAIL_TOKEN=

# Optional analytics (leave unset in local dev; production reference IDs below)
# VITE_GA_MEASUREMENT_ID=G-HCMV8LSMX1
# VITE_ADSENSE_CLIENT=ca-pub-3166031954805282
VITE_GA_MEASUREMENT_ID=
VITE_ADSENSE_CLIENT=
